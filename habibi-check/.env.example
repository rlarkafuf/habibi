# Habibi Check - Production Data Layer Configuration
# Supported providers: 'auto' | 'supabase' | 'api' | 'local'
VITE_DATA_PROVIDER=auto

# 1. Supabase Direct REST / PostgREST Configuration (Optional)
# When configured, propertyService automatically queries your Supabase 'properties' & 'dari_transactions' tables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROPERTIES_TABLE=properties

# 2. External Crawler / Portal Feed JSON Endpoint (Optional)
# Connect live Property Finder / Bayut / DARI webhook or JSON feed URL
VITE_EXTERNAL_FEED_URL=

